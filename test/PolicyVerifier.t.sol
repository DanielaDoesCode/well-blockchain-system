pragma solidity ^0.8.20;

import "forge-std/Test.sol";
import "../src/PolicyVerifier.sol";

contract PolicyVerifierTest is Test {
    PolicyVerifier public verifier;

    // Proof A generated by zk-circuits/gen_policy_proof.js with:
    //   department = 0x1111...11, institution = 0x2222...22,
    //   requiredDept = 0x1111...11, requiredInst = 0x2222...22,
    //   doctorAddr = 0x...0001, validUntil = 1781536000, evaluatedAt = 1750000000
    uint256[2] internal pA = [
        uint256(17749563003958815978953565070961340461836647835011941111424515940428376907718),
        uint256(4343310052084520144226717958615460601535835760159473856528055549674236178475)
    ];
    uint256[2][2] internal pB = [
        [uint256(12450916388111255360561991966519019842536551587698933560671727733323273889458),
         uint256(18928262754817229482333214559706493925645187840605793615228364354707553787885)],
        [uint256(4524717860817071861674610336557751705437115145070303733957411309972002126946),
         uint256(20458358698452852315033311969357989944415481030582626379549270293295068073066)]
    ];
    uint256[2] internal pC = [
        uint256(15200803100421121808902431370918802603255786112118688551529861049755358388782),
        uint256(18090051901104465583333513076733811991829267041731573868887924952520343706137)
    ];

    // [deptCommitment, instCommitment, doctorCommitment, evaluatedAt]
    uint256[4] internal pubSignals = [
        uint256(0x18f447fe0780f480be2efdec415f8eac78a73bbaa10085b99a9852354330219b),
        uint256(0x15cd25d14834cb5b5acee14d67fb0660ae6f080ccc3ff1cbcc7e1ac4cb6dd62d),
        uint256(0x2eaa00ff94aa542b726083d39a960fa6c3f79dded2d9bb24511ac009971ee7ed),
        uint256(1750000000)
    ];

    function setUp() public {
        verifier = new PolicyVerifier();
    }

    function test_ValidProof() public view {
        assertTrue(verifier.verifyProof(pA, pB, pC, pubSignals));
    }

    function test_InvalidProofRejected() public view {
        uint256[2] memory badA = pA;
        badA[0] = badA[0] ^ 1;
        assertFalse(verifier.verifyProof(badA, pB, pC, pubSignals));
    }
}
